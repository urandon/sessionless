# Safe local defaults only. Never store tokens, API keys, or service-account JSON here.
APP_ENV=local
SESSIONLESS_ENVIRONMENT=local
LOG_LEVEL=debug
PORT=8080

YDB_ENDPOINT=grpc://localhost:2136
YDB_DATABASE=/local
YDB_CONNECTION_STRING=grpc://localhost:2136/local?go_query_mode=scripting&go_fake_tx=scripting&go_query_bind=declare,numeric
YDB_ANONYMOUS_CREDENTIALS=1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=sessionless-local
S3_ACCESS_KEY_ID=sessionless-local
S3_SECRET_ACCESS_KEY=sessionless-local-secret
S3_FORCE_PATH_STYLE=1
QUEUE_ENDPOINT=http://localhost:9324
QUEUE_REGION=us-east-1
QUEUE_ACCESS_KEY_ID=sessionless-local
QUEUE_SECRET_ACCESS_KEY=sessionless-local-secret
DISPATCH_QUEUE_URL=http://localhost:9324/000000000000/sessionless-dispatch
SCHEDULER_WAKE_QUEUE_URL=http://localhost:9324/000000000000/sessionless-scheduler-wake
DELIVERY_QUEUE_URL=http://localhost:9324/000000000000/sessionless-delivery
DEAD_LETTER_QUEUE_URL=http://localhost:9324/000000000000/sessionless-dlq
SCHEDULER_WAKE_DEAD_LETTER_QUEUE_URL=http://localhost:9324/000000000000/sessionless-dlq
DELIVERY_DEAD_LETTER_QUEUE_URL=http://localhost:9324/000000000000/sessionless-dlq
OUTBOX_QUEUE_ACCESS_KEY_ID=sessionless-local
OUTBOX_QUEUE_SECRET_ACCESS_KEY=sessionless-local-secret
TELEGRAM_API_BASE_URL=http://localhost:8081
TELEGRAM_FAKE_TOKEN=local-test-token
TELEGRAM_SOURCE_ID=bot-primary
DEFAULT_COMPUTE_PROVIDER=codex
TELEGRAM_SENDER_QUEUE_WAIT=2s
SCHEDULER_QUEUE_WAIT=2s
SCHEDULER_WAKE_RETRY_DELAY=1s
SCHEDULER_WAKE_MAX_DELIVERY_COUNT=5
SCHEDULER_RESERVATION_TTL=5m
SCHEDULER_BATCH_SIZE=25
LIMIT_TENANT_QUEUE_DEPTH=8
LIMIT_ACTIVE_RUNS=1
LIMIT_RUNTIME=15m
LIMIT_TURNS=30
LIMIT_INPUT_BYTES=16777216
LIMIT_CONTEXT_BYTES=67108864
LIMIT_CONTEXT_EVENTS=512
LIMIT_ARTIFACTS=32
LIMIT_TOOL_EVENTS=128
LIMIT_TOOL_EVENT_BYTES=16777216
DEFAULT_WORKLOAD_RUNTIME=5m
DEFAULT_WORKLOAD_TURNS=1
DEFAULT_WORKLOAD_INPUT_BYTES=1048576
DEFAULT_WORKLOAD_CONTEXT_BYTES=4194304
DEFAULT_WORKLOAD_ARTIFACTS=4
WORKER_ID=worker-runtime
WORKER_SCRATCH_ROOT=/tmp/sessionless-worker
WORKER_LEASE_TTL=2m
WORKER_RETRY_DELAY=5s
WORKER_QUEUE_WAIT=2s
WORKER_MAX_DELIVERY_COUNT=5
WORKER_MAX_BLOB_BYTES=67108864
WORKER_MAX_SNAPSHOT_FALLBACKS=4
DETERMINISTIC_HARNESS_TURNS=2
DETERMINISTIC_HARNESS_ARTIFACTS=1
DETERMINISTIC_HARNESS_FAIL_AT_TURN=0
DETERMINISTIC_HARNESS_RETRYABLE_FAIL=false

# Inject secrets from the process environment or an OS secret store.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_IDENTITY_HMAC_KEY=

# Web BFF and local-only Telegram-shaped OIDC fixture. Values below are
# coordinates, not production credentials. Keep real client secrets in an OS
# secret store locally and in Lockbox for cloud deployments.
WEB_BASE_URL=https://web.localhost
WEB_PORT=8083
TELEGRAM_OIDC_ISSUER=https://oidc.localhost
TELEGRAM_OIDC_AUTHORIZATION_ENDPOINT=http://127.0.0.1:8082/auth
TELEGRAM_OIDC_TOKEN_ENDPOINT=http://127.0.0.1:8082/token
TELEGRAM_OIDC_JWKS_URL=http://127.0.0.1:8082/.well-known/jwks.json
TELEGRAM_OIDC_CLIENT_ID=100000
TELEGRAM_OIDC_CLIENT_SECRET=
OIDC_FIXTURE_ISSUER=https://oidc.localhost
OIDC_FIXTURE_CLIENT_ID=100000
OIDC_FIXTURE_CLIENT_SECRET=
OIDC_FIXTURE_REDIRECT_URI=https://web.localhost/auth/telegram/callback
OIDC_FIXTURE_SUBJECT=424242
