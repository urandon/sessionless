# Safe local defaults only. Never store tokens, API keys, or service-account JSON here.
APP_ENV=local
LOG_LEVEL=debug
PORT=8080

YDB_ENDPOINT=grpc://ydb-local:2136
YDB_DATABASE=/local
S3_ENDPOINT=http://object-storage-local:9000
QUEUE_ENDPOINT=http://queue-local:9324
TELEGRAM_API_BASE_URL=http://telegram-fake:8081

# Inject secrets from the process environment or an OS secret store.
TELEGRAM_BOT_TOKEN=
