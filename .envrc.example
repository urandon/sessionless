# Copy this file to .envrc and adjust paths for the local machine. The real
# .envrc is ignored because it may contain machine-specific paths or secrets.
repo_root=$(git rev-parse --show-toplevel)
workspace_root=$(CDPATH= cd -- "$repo_root/../.." && pwd -P)

export SESSIONLESS_NATIVE_DEPS_DIR=${SESSIONLESS_NATIVE_DEPS_DIR:-$workspace_root/ai/sessionless-native-deps}
export SESSIONLESS_DOCKERLESS_ROOT=${SESSIONLESS_DOCKERLESS_ROOT:-$workspace_root/ai/sessionless-native-runtime}
export YDBD_PATH=${YDBD_PATH:-$workspace_root/artifacts/ydb/25.3.1.25/darwin-x86_64/ydbd-25.3.1.25-darwin-x86_64}
export YDB_LOCAL_LAUNCHER_PATH=${YDB_LOCAL_LAUNCHER_PATH:-$workspace_root/artifacts/ydb/25.3.1.25/darwin-x86_64/local_ydb-25.3.1.25-darwin-x86_64}

# Optional native local inference, AFTER explicit operator installation. Leave
# these commented until the same accepted receipt is available to all three
# processes; never copy synthetic test evidence into an operator installation.
# export WEB_LOCAL_EXECUTION_ENABLED=true
# export WORKER_LOCAL_EXECUTION_ENABLED=true
# export WEB_LOCAL_INSTALLATION_ROOT=/absolute/workspace/private-installation
# export WEB_LOCAL_WORKER_EXECUTABLE=/absolute/workspace/sessionless/.build/bin/worker-runtime
# export WEB_LOCAL_PROFILE_RECEIPT_FILE=/absolute/workspace/private-receipts/local-profile.json
# Configure WEB_BASE_URL, WEB_LOGIN_PROVIDERS=yandex, WEB_PORT and the existing
# login/session/storage settings separately; use yandex,telegram for both methods.
# Set WEB_IDENTITY_VERSION=1 and WEB_IDENTITY_SENSITIVE_OPERATIONS=false before
# the separate reviewed V2 data/writer cutover; version is not autodetected.
# Unset the retired singular variable; never commit real secrets here.

unset repo_root workspace_root
