{
  "name": "@sessionless/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "packageManager": "npm@11.17.0",
  "volta": {
    "node": "24.19.0",
    "npm": "11.17.0"
  },
  "scripts": {
    "api:generate": "openapi-typescript src/lib/api/openapi.json -o src/lib/api/generated.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/lib/api/generated.ts",
    "build": "vite build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "dev": "vite dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:a11y": "playwright test --grep @a11y",
    "test:e2e": "playwright test --grep-invert @a11y",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@sveltejs/adapter-static": "3.0.10",
    "@sveltejs/kit": "2.70.3",
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/svelte": "5.4.2",
    "eslint": "10.8.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.11.0",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "4.1.1",
    "svelte": "5.56.9",
    "svelte-check": "4.7.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@noble/hashes": "2.3.0"
  }
}
